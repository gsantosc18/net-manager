# =====================================================================
# Configurações das Operadoras de Internet (WAN)
# Altere os nomes abaixo conforme suas operadoras (ex: Claro Fibra, Vivo Fibra)
# =====================================================================
WAN1_NAME=Claro
WAN2_NAME=WLan

# IPs de teste/qualidade (ICMP Ping)
WAN1_TARGET=9.9.9.9
WAN2_TARGET=149.112.112.112

# Intervalos de Medição (segundos)
PING_INTERVAL=10
PING_COUNT=5
SPEEDTEST_INTERVAL=1800

# Avaliação Horária e Failover ER605
FAILOVER_ENABLED=true
FAILOVER_INTERVAL=3600
FLAPPING_MIN_SCORE_DIFF=3.0
EMERGENCY_FAILOVER=true
ER605_HOST=192.168.10.1
ER605_USER=admin
ER605_PASS=sua_senha_aqui

    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 105,
      "options": {
        "content": "<div style=\"display: flex; align-items: center; justify-content: space-between; padding: 14px 22px; background: rgba(22, 27, 34, 0.9); border-radius: 8px; border: 1px solid rgba(56, 189, 248, 0.25); box-shadow: 0 4px 16px rgba(0,0,0,0.2);\">\n  <div style=\"display: flex; align-items: center; gap: 14px;\">\n    <span style=\"font-size: 28px;\">\u26a1</span>\n    <div>\n      <div style=\"font-size: 15px; font-weight: 600; color: #f8fafc; letter-spacing: 0.3px;\">Central de A\u00e7\u00f5es Manuais</div>\n      <div id=\"action-status\" style=\"font-size: 12.5px; color: #94a3b8; transition: all 0.3s;\">Escolha uma das a\u00e7\u00f5es abaixo para avaliar a qualidade e chaveamento ou medir a velocidade real das conex\u00f5es.</div>\n    </div>\n  </div>\n  <div style=\"display: flex; align-items: center; gap: 12px;\">\n    <button id=\"eval-btn\" onclick=\"triggerEvaluation()\" style=\"background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.2); padding: 9px 20px; font-size: 13px; font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(124,58,237,0.3); transition: all 0.2s;\">\n      <span>\u2696\ufe0f</span> Avaliar e Chavear Rota\n    </button>\n    <button id=\"st-btn\" onclick=\"triggerSpeedtest()\" style=\"background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border: 1px solid rgba(255,255,255,0.2); padding: 9px 20px; font-size: 13px; font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(37,99,235,0.3); transition: all 0.2s;\">\n      <span>\ud83d\ude80</span> Testar Velocidade Real\n    </button>\n  </div>\n</div>\n\n<script>\nfunction triggerEvaluation() {\n  const btn = document.getElementById(\"eval-btn\");\n  const status = document.getElementById(\"action-status\");\n  if (!btn || !status) return;\n\n  btn.disabled = true;\n  btn.style.opacity = \"0.6\";\n  btn.style.cursor = \"not-allowed\";\n  btn.innerHTML = \"<span>\u23f3</span> Avaliando Conex\u00f5es...\";\n  status.innerText = \"Consultando notas de estabilidade e verificando status do ER605...\";\n  status.style.color = \"#a78bfa\";\n\n  const host = window.location.hostname || \"localhost\";\n  fetch(\"http://\" + host + \":8010/api/evaluation/run\", { method: \"POST\" })\n    .then(r => r.json())\n    .then(data => {\n      status.innerText = \"\u2705 \" + data.message;\n      status.style.color = \"#4ade80\";\n      setTimeout(() => {\n        btn.disabled = false;\n        btn.style.opacity = \"1\";\n        btn.style.cursor = \"pointer\";\n        btn.innerHTML = \"<span>\u2696\ufe0f</span> Avaliar e Chavear Rota\";\n      }, 4000);\n    })\n    .catch(err => {\n      status.innerText = \"\u274c Erro ao solicitar avalia\u00e7\u00e3o: \" + err;\n      status.style.color = \"#f87171\";\n      btn.disabled = false;\n      btn.style.opacity = \"1\";\n      btn.style.cursor = \"pointer\";\n      btn.innerHTML = \"<span>\ud83d\udd04</span> Tentar Novamente\";\n    });\n}\n\nfunction triggerSpeedtest() {\n  const btn = document.getElementById(\"st-btn\");\n  const status = document.getElementById(\"action-status\");\n  if (!btn || !status) return;\n  \n  btn.disabled = true;\n  btn.style.opacity = \"0.6\";\n  btn.style.cursor = \"not-allowed\";\n  btn.innerHTML = \"<span>\u23f3</span> Testando Conex\u00f5es...\";\n  status.innerText = \"Medi\u00e7\u00e3o Ookla Speedtest em andamento (dura\u00e7\u00e3o aprox. 25 a 30 segundos)...\";\n  status.style.color = \"#38bdf8\";\n\n  const host = window.location.hostname || \"localhost\";\n  fetch(\"http://\" + host + \":8010/api/speedtest/run\", { method: \"POST\" })\n    .then(r => r.json())\n    .then(data => {\n      status.innerText = \"\u2705 \" + data.message + \" Os cart\u00f5es abaixo atualizar\u00e3o em instantes.\";\n      status.style.color = \"#4ade80\";\n      setTimeout(() => {\n        btn.disabled = false;\n        btn.style.opacity = \"1\";\n        btn.style.cursor = \"pointer\";\n        btn.innerHTML = \"<span>\ud83d\ude80</span> Testar Velocidade Real\";\n        status.innerText = \"Escolha uma das a\u00e7\u00f5es abaixo para avaliar a qualidade e chaveamento ou medir a velocidade real das conex\u00f5es.\";\n        status.style.color = \"#94a3b8\";\n      }, 35000);\n    })\n    .catch(err => {\n      status.innerText = \"\u274c Falha ao comunicar com o servidor Net-Monitor (porta 8010): \" + err;\n      status.style.color = \"#f87171\";\n      btn.disabled = false;\n      btn.style.opacity = \"1\";\n      btn.style.cursor = \"pointer\";\n      btn.innerHTML = \"<span>\ud83d\udd04</span> Tentar Novamente\";\n    });\n}\n</script>",
        "mode": "html"
      },
      "title": "",
      "transparent": true,
      "type": "text"
    },
